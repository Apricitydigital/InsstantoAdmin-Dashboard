rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function roleData() {
      return get(/databases/$(database)/documents/roles/$(userData().roleId)).data;
    }

    function tokenHasRole(role) {
      return signedIn()
        && 'roleId' in request.auth.token
        && request.auth.token.roleId == role;
    }

    function userHasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().roleId == role;
    }

    function customerHasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/customer/$(request.auth.uid))
        && get(/databases/$(database)/documents/customer/$(request.auth.uid)).data.roleId == role;
    }

    function hasRole(role) {
      // Prefer the Firestore profile when it exists so role assignments made
      // by a super admin are not overridden by an older token claim.
      return userHasRole(role)
        || (signedIn()
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && tokenHasRole(role))
        || customerHasRole(role);
    }

    function isSuperAdmin() {
      return hasRole('superadmin');
    }

    function canViewDashboard() {
      return isSuperAdmin() || hasRole('admin');
    }

    function isStoreManager() {
      return hasRole('store_manager');
    }

    function hasPermission(permission) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/roles/$(userData().roleId))
        && roleData().permissions.hasAny([permission]);
    }

    function canRead(permission) {
      return canViewDashboard() || hasPermission(permission);
    }

    function canResolveComplaint() {
      return hasRole('admin') || hasPermission('complaints:write');
    }

    function isResolutionOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['complaint_status', 'timeslot', 'complaint_history']);
    }

    // Customers and admins must be able to read coverage. Only verified admin
    // roles (or a role explicitly granted services:write) may change it.
    match /service_coverage/{cityId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin() || hasPermission('services:write');

      match /Categories/{categoryId} {
        allow read: if signedIn();
        allow write: if isSuperAdmin() || hasPermission('services:write');

        match /service_hubs/{hubId} {
          allow read: if signedIn();
          allow write: if isSuperAdmin() || hasPermission('services:write');
        }
      }
    }

    // The catalogue is displayed in the admin and already consumed by the
    // customer application. Catalogue mutation is outside this screen.
    match /service_subcategories/{docId} { allow read: if signedIn(); }
    match /service_SubCategoriesItems/{docId} { allow read: if signedIn(); }
    match /service_subCategoriesItems/{docId} { allow read: if signedIn(); }
    match /itemOptions/{docId} { allow read: if signedIn(); }
    match /service_packages/{docId} { allow read: if signedIn(); }
    match /Service_Categories/{docId} { allow read: if signedIn(); }
    match /service_categories/{docId} { allow read: if signedIn(); }

    match /bookings/{docId} {
      allow read: if canRead('bookings:view');
      allow write: if isSuperAdmin() || hasPermission('bookings:write');
    }
    match /payments/{docId} {
      allow read: if canRead('payments:view');
      allow write: if isSuperAdmin() || hasPermission('payments:write');
    }
    match /store/{docId} {
      allow read: if canRead('store:view') || isStoreManager();
      allow write: if isSuperAdmin() || hasPermission('store:write');
    }
    match /coupons/{docId} {
      allow read: if canRead('coupons:view');
      allow write: if isSuperAdmin() || hasPermission('coupons:write');
    }
    match /coupon/{docId} {
      allow read: if canRead('coupons:view');
      allow write: if isSuperAdmin() || hasPermission('coupons:write');
    }
    match /customers/{docId} {
      allow read: if canRead('customers:view') || hasPermission('customers:view_limited');
      allow write: if isSuperAdmin() || hasPermission('customers:write');
    }
    match /customer/{docId} {
      allow read: if canRead('customers:view')
        || hasPermission('customers:view_limited')
        || hasPermission('partners:view')
        || hasPermission('partners:manage');
      allow write: if isSuperAdmin()
        || hasPermission('customers:write')
        || hasPermission('partners:manage');
    }

    // Partner credit adjustments are managed from the partner details page.
    // Balance and history writes are committed together in a transaction.
    match /partner_overall_credits/{docId} {
      allow read: if canRead('partners:view') || canRead('customers:view');
      allow write: if isSuperAdmin()
        || hasPermission('partners:manage')
        || hasPermission('customers:write');
    }
    match /credits_purchase_record/{docId} {
      allow read: if canRead('partners:view') || canRead('customers:view');
      allow write: if isSuperAdmin()
        || hasPermission('partners:manage')
        || hasPermission('customers:write');
    }
    match /chemical_spend_record/{docId} {
      allow read: if canRead('partners:view') || canRead('customers:view');
      allow write: if isSuperAdmin()
        || hasPermission('partners:manage')
        || hasPermission('customers:write');
    }
    match /complaints/{docId} {
      allow read: if canRead('complaints:view');
      allow write: if isSuperAdmin() || (canResolveComplaint() && isResolutionOnly());
    }
    match /customer_complain/{docId} {
      allow read: if canRead('complaints:view');
      allow update: if isSuperAdmin() || (canResolveComplaint() && isResolutionOnly());
      allow create, delete: if isSuperAdmin();
    }
    match /roles/{docId} {
      allow read: if isSuperAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userData().roleId == docId);
      allow write: if isSuperAdmin();
    }
    match /users/{docId} {
      allow read: if signedIn() && (request.auth.uid == docId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /store_items/{docId} {
      allow read: if canRead('store:view') || isStoreManager();
      allow write: if isSuperAdmin() || hasPermission('store:write');
    }

    match /chemical_purchase_record/{docId} {
      allow read: if canRead('store:view') || isStoreManager();
      allow write: if isSuperAdmin() || hasPermission('store:write');
    }

    // Admin and superadmin can read every dashboard collection. Only the
    // superadmin role receives dashboard-wide mutation rights.
    match /{document=**} {
      allow read: if canViewDashboard() || hasPermission('analytics:view');
      allow write: if isSuperAdmin();
    }
  }
}
