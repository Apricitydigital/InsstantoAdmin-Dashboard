rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function roleData() {
      return get(/databases/$(database)/documents/roles/$(userData().roleId)).data;
    }

    function tokenHasRole(role) {
      return signedIn()
        && 'roleId' in request.auth.token
        && request.auth.token.roleId == role;
    }

    function userHasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().roleId == role;
    }

    function customerHasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/customer/$(request.auth.uid))
        && get(/databases/$(database)/documents/customer/$(request.auth.uid)).data.roleId == role;
    }

    function hasRole(role) {
      // Prefer the Firestore profile when it exists so role assignments made
      // by a super admin are not overridden by an older token claim.
      return userHasRole(role)
        || (signedIn()
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && tokenHasRole(role))
        || customerHasRole(role);
    }

    function isSuperAdmin() {
      return hasRole('superadmin');
    }

    function canViewDashboard() {
      return isSuperAdmin() || hasRole('admin');
    }

    function isStoreManager() {
      return hasRole('store_manager');
    }

    function hasPermission(permission) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/roles/$(userData().roleId))
        && roleData().permissions.hasAny([permission]);
    }

    function canRead(permission) {
      return canViewDashboard() || hasPermission(permission);
    }

    function isAdminNoteOnly() {
      let oldHistory = resource.data.get('complaint_history', []);
      let newHistory = request.resource.data.get('complaint_history', []);
      let addedNote = newHistory[newHistory.size() - 1];
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['complaint_history'])
        && oldHistory is list
        && newHistory is list
        && newHistory.size() == oldHistory.size() + 1
        && newHistory[0:oldHistory.size()] == oldHistory
        && addedNote is map
        && addedNote.keys().hasOnly(['message', 'timestamp', 'type'])
        && addedNote.message is string
        && addedNote.message.size() > 0
        && addedNote.type == 'admin_note';
    }

    // Slot-unavailability telemetry is append-only, including for superadmins.
    match /slot_unavailability_events/{eventId} {
      allow read: if canRead('analytics:view');
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'eventType', 'eventVersion', 'createdAt', 'clientCreatedAt', 'source',
          'subCategoryId', 'serviceCoverageCityId', 'serviceCoverageCategoryId',
          'serviceHubId', 'reasonCode', 'daysSearched', 'platform', 'diagnostics',
          'customer_id', 'customerUid', 'visitId', 'openedAt', 'snapshotAt', 'outcome', 'timeZone', 'slotDays'
        ])
        && (!('customerUid' in request.resource.data)
          || (request.resource.data.customerUid is string && request.resource.data.customerUid == request.auth.uid))
        && (!('customer_id' in request.resource.data)
          || (request.resource.data.customer_id is path
            && request.resource.data.customer_id == /databases/$(database)/documents/customer/$(request.auth.uid)))
        && ((request.resource.data.eventType == 'slots_unavailable'
            && request.resource.data.eventVersion == 1
            && !request.resource.data.keys().hasAny(['visitId', 'openedAt', 'snapshotAt', 'outcome', 'timeZone', 'slotDays']))
          || (request.resource.data.eventType == 'slot_visit_ended'
            && request.resource.data.eventVersion == 2
            && request.resource.data.visitId == eventId
            && request.resource.data.openedAt is timestamp
            && request.resource.data.snapshotAt is timestamp
            && request.resource.data.openedAt <= request.resource.data.snapshotAt
            && request.resource.data.snapshotAt <= request.resource.data.clientCreatedAt
            && request.resource.data.outcome in ['back_unbooked', 'booked']
            && request.resource.data.timeZone is string
            && request.resource.data.slotDays is list
            && request.resource.data.slotDays.size() == request.resource.data.daysSearched)
          || (request.resource.data.eventType == 'slot_availability_snapshot'
            && request.resource.data.eventVersion == 2
            && request.resource.data.visitId == eventId
            && request.resource.data.openedAt is timestamp
            && request.resource.data.snapshotAt is timestamp
            && request.resource.data.openedAt <= request.resource.data.snapshotAt
            && request.resource.data.snapshotAt <= request.resource.data.clientCreatedAt
            && request.resource.data.outcome == 'viewed'
            && request.resource.data.timeZone is string
            && request.resource.data.slotDays is list
            && request.resource.data.slotDays.size() == request.resource.data.daysSearched))
        && request.resource.data.createdAt == request.time
        && request.resource.data.clientCreatedAt is timestamp
        && request.resource.data.source in ['checkout_regular', 'checkout_monthly', 'reschedule']
        && request.resource.data.subCategoryId is string
        && request.resource.data.serviceCoverageCityId is string
        && request.resource.data.serviceCoverageCategoryId is string
        && request.resource.data.serviceHubId is string
        && request.resource.data.reasonCode is string
        && request.resource.data.daysSearched == 7
        && request.resource.data.platform is string
        && request.resource.data.diagnostics is map;
      allow update, delete: if false;
    }
    match /slot_availability_requests/{requestId} {
      allow read: if canRead('analytics:view');
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'createdAt', 'customer_id', 'customerUid', 'visitId', 'requestedDate',
          'source', 'subCategoryId', 'serviceCoverageCityId',
          'serviceCoverageCategoryId', 'serviceHubId', 'priority', 'status',
          'platform'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customer_id ==
          /databases/$(database)/documents/customer/$(request.auth.uid)
        && request.resource.data.visitId is string
        && request.resource.data.requestedDate is string
        && request.resource.data.source in [
          'checkout_regular', 'checkout_monthly', 'reschedule'
        ]
        && request.resource.data.subCategoryId is string
        && request.resource.data.serviceCoverageCityId is string
        && request.resource.data.serviceCoverageCategoryId is string
        && request.resource.data.serviceHubId is string
        && request.resource.data.priority == 'urgent'
        && request.resource.data.status == 'open'
        && request.resource.data.platform is string;
      allow update: if canRead('analytics:view')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'handledAt'])
        && request.resource.data.status == 'handled'
        && request.resource.data.handledAt == request.time;
      allow delete: if false;
    }

    // Customers and admins can read coverage. Only superadmins may change it.
    match /service_coverage/{cityId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();

      match /Categories/{categoryId} {
        allow read: if signedIn();
        allow write: if isSuperAdmin();

        match /service_hubs/{hubId} {
          allow read: if signedIn();
          allow write: if isSuperAdmin();
        }
      }
    }

    // The catalogue is displayed in the admin and already consumed by the
    // customer application. Catalogue mutation is outside this screen.
    match /service_subcategories/{docId} { allow read: if signedIn(); }
    match /service_SubCategoriesItems/{docId} { allow read: if signedIn(); }
    match /service_subCategoriesItems/{docId} { allow read: if signedIn(); }
    match /itemOptions/{docId} { allow read: if signedIn(); }
    match /service_packages/{docId} { allow read: if signedIn(); }
    match /Service_Categories/{docId} { allow read: if signedIn(); }
    match /service_categories/{docId} { allow read: if signedIn(); }

    match /bookings/{docId} {
      allow read: if canRead('bookings:view');
      allow write: if isSuperAdmin();
    }
    match /payments/{docId} {
      allow read: if canRead('payments:view');
      allow write: if isSuperAdmin();
    }
    match /store/{docId} {
      allow read: if canRead('store:view') || isStoreManager();
      allow write: if isSuperAdmin();
    }
    match /coupons/{docId} {
      allow read: if canRead('coupons:view');
      allow write: if isSuperAdmin();
    }
    match /coupon/{docId} {
      allow read: if canRead('coupons:view');
      allow write: if isSuperAdmin();
    }
    match /customers/{docId} {
      allow read: if canRead('customers:view') || hasPermission('customers:view_limited');
      allow write: if isSuperAdmin();
    }
    match /customer/{docId} {
      allow read: if canRead('customers:view')
        || hasPermission('customers:view_limited')
        || hasPermission('partners:view')
        || hasPermission('partners:manage');
      allow write: if isSuperAdmin();
    }

    // Partner credit adjustments are managed from the partner details page.
    // Balance and history writes are committed together in a transaction.
    match /partner_overall_credits/{docId} {
      allow read: if canRead('partners:view') || canRead('customers:view');
      allow write: if isSuperAdmin();
    }
    match /credits_purchase_record/{docId} {
      allow read: if canRead('partners:view') || canRead('customers:view');
      allow write: if isSuperAdmin();
    }
    match /credits_spend_record/{docId} {
      allow read: if canRead('partners:view') || canRead('customers:view');
      allow write: if isSuperAdmin();
    }
    match /chemical_spend_record/{docId} {
      allow read: if canRead('partners:view') || canRead('customers:view');
      allow write: if isSuperAdmin();
    }
    // Loan records are visible with partner access, but only superadmins can
    // create or manage a partner's current loan from the partner details page.
    match /PartnerKitLoan/{docId} {
      allow read: if canRead('partners:view');
      allow write: if isSuperAdmin();
    }
    match /complaints/{docId} {
      allow read: if canRead('complaints:view');
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (hasRole('admin') && isAdminNoteOnly());
    }
    match /customer_complain/{docId} {
      allow read: if canRead('complaints:view');
      allow update: if isSuperAdmin() || (hasRole('admin') && isAdminNoteOnly());
      allow create, delete: if isSuperAdmin();
    }
    match /roles/{docId} {
      allow read: if isSuperAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userData().roleId == docId);
      allow write: if isSuperAdmin();
    }
    match /users/{docId} {
      allow read: if signedIn() && (request.auth.uid == docId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /store_items/{docId} {
      allow read: if canRead('store:view') || isStoreManager();
      allow write: if isSuperAdmin();
    }

    match /chemical_purchase_record/{docId} {
      allow read: if canRead('store:view') || isStoreManager();
      allow write: if isSuperAdmin();
    }

    // Admin and superadmin can read every dashboard collection. Only the
    // superadmin role receives dashboard-wide mutation rights.
    match /{collectionName}/{document=**} {
      allow read: if canViewDashboard() || hasPermission('analytics:view');
      allow write: if collectionName != 'slot_unavailability_events'
        && collectionName != 'slot_availability_requests'
        && isSuperAdmin();
    }
  }
}
